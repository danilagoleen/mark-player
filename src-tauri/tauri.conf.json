{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mark Player",
  "version": "0.25.1",
  "identifier": "ai.vetka.playerlab",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:1424",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Mark Player 0.25.1 beta",
        "width": 1280,
        "height": 860,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost; media-src 'self' data: blob: asset: http://asset.localhost;",
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/**", "/Volumes/**", "$TEMP/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "endpoints": [
        "https://github.com/danilagoleen/mark-player/releases/latest/download/latest.json"
      ],
      "pubkey": "ZFc1MGNuVnpkR1ZrSUdOdmJXMWxiblE2SUcxcGJtbHphV2R1SUhCMVlteHBZeUJyWlhrNklFSXpNRU0xT1VNMk1VRkZRa1V3TVVZS1VsZFJaalJQYzJGNGJHdE5jeXRrUW01bmFXWlZUWFoyZUhoVVFYVlpXaXQyV2pRMFFWbFhja3d3YlRjeE1ubFJRa1pqU3pWcUswd0s="
    }
  }
}
